# URLs des APIs backend
NUXT_PUBLIC_CONTENT_API_BASE=http://localhost:3001
NUXT_PUBLIC_IDENTITY_API_BASE=http://localhost:3002

# URL publique du site, sans slash final.
# OBLIGATOIRE en production : elle sert à construire les liens de partage et les balises
# Open Graph des actualités et événements. Sans elle, le HTML prérendu contiendrait
# `http://localhost` et les aperçus de partage seraient inutilisables.
NUXT_PUBLIC_SITE_URL=https://alumni-esatic.com

NUXT_PUBLIC_UMAMI_ID=id-prod
NUXT_PUBLIC_UMAMI_HOST=https://analytics.monsite.com

# ---------------------------------------------------------------------------
# Observabilité SigNoz (OpenTelemetry — traces, logs, métriques)
# ---------------------------------------------------------------------------
# Activer l'instrumentation (désactivée si absent ou différent de "true")
NUXT_PUBLIC_OTEL_ENABLED=true

# Base du collecteur OTLP/HTTP self-hosted (sans le chemin /v1/...)
# Les chemins /v1/traces, /v1/logs et /v1/metrics sont ajoutés automatiquement.
# Le collecteur doit être joignable depuis le navigateur et autoriser le CORS
# de l'origine du front. Pas de header d'ingestion en self-hosted.
NUXT_PUBLIC_OTEL_COLLECTOR_URL=https://otel-collector.alumni-esatic.com

# Surcharges optionnelles (seulement si un signal utilise un autre endpoint)
# NUXT_PUBLIC_OTEL_TRACES_URL=https://otel-collector.alumni-esatic.com/v1/traces
# NUXT_PUBLIC_OTEL_LOGS_URL=https://otel-collector.alumni-esatic.com/v1/logs
# NUXT_PUBLIC_OTEL_METRICS_URL=https://otel-collector.alumni-esatic.com/v1/metrics

# Identité du service dans SigNoz
NUXT_PUBLIC_OTEL_SERVICE_NAME=repae-frontend
NUXT_PUBLIC_OTEL_SERVICE_VERSION=1.0.0
NUXT_PUBLIC_OTEL_ENVIRONMENT=production

# Réglages fins
NUXT_PUBLIC_OTEL_TRACES_SAMPLE_RATE=1
NUXT_PUBLIC_OTEL_METRICS_INTERVAL=60000
NUXT_PUBLIC_OTEL_USER_INTERACTION=true
NUXT_PUBLIC_OTEL_WEB_VITALS=true
NUXT_PUBLIC_OTEL_DEBUG=false
