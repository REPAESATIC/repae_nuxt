# URLs des APIs backend
NUXT_PUBLIC_CONTENT_API_BASE=http://localhost:3001
NUXT_PUBLIC_IDENTITY_API_BASE=http://localhost:3002

NUXT_PUBLIC_UMAMI_ID=id-prod
NUXT_PUBLIC_UMAMI_HOST=https://analytics.monsite.com

# Observabilité OpenTelemetry / SigNoz
# Pointe vers votre collector si vous en avez un, sinon vers l'endpoint SigNoz.
OTEL_TRACES_EXPORTER=otlp
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
OTEL_NODE_RESOURCE_DETECTORS=env,host,os
OTEL_SERVICE_NAME=repae-frontend
OTEL_RESOURCE_ATTRIBUTES=service.version=dev
# Exemple SigNoz Cloud:
# OTEL_EXPORTER_OTLP_ENDPOINT=https://ingest.<region>.signoz.cloud:443
# OTEL_EXPORTER_OTLP_HEADERS=signoz-ingestion-key=<your-ingestion-key>